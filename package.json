{
  "name": "@dahch/huginn",
  "version": "2.0.0-rc.1",
  "description": "CLI/TUI orchestrator for the opencode spec → execute → validate → test → secure → review → doc → commit cycle",
  "type": "module",
  "bin": {
    "huginn": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "scripts"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test && vitest run",
    "postinstall": "node -e \"try{require('child_process').execSync('bun --version')}catch(e){console.warn('[huginn] Bun is required. Install it from https://bun.sh');process.exit(0)}\" && bun run scripts/postinstall.ts",
    "prepublishOnly": "bun run build && npm run test && bun run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opencode-ai/sdk": "^1.18.14",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dahch/huginn"
  },
  "keywords": [
    "opencode",
    "cli",
    "orchestrator",
    "spec",
    "build-cycle"
  ],
  "homepage": "https://github.com/dahch/huginn#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
