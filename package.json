{
  "name": "@dahch/huginn",
  "version": "3.0.0-rc.1",
  "description": "CLI/TUI orchestrator for the agent-driven spec → execute → validate → test → secure → review → doc → commit cycle",
  "type": "module",
  "bin": {
    "huginn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist --minify --external @earendil-works/pi-coding-agent --external @openai/codex-sdk --external @anthropic-ai/claude-agent-sdk",
    "typecheck": "tsc --noEmit",
    "test": "bun test src && vitest run",
    "prepublishOnly": "bun run build && npm run test && bun run typecheck"
  },
  "dependencies": {
    "@dahch/muninn": "https://github.com/dahch/muninn/releases/download/v0.1.0/dahch-muninn-0.1.0.tgz",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@openai/codex-sdk": "0.163.0",
    "@opencode-ai/sdk": "^1.18.14",
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dahch/huginn"
  },
  "keywords": [
    "opencode",
    "cli",
    "orchestrator",
    "spec",
    "build-cycle"
  ],
  "homepage": "https://github.com/dahch/huginn#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
