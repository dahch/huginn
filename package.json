{
  "name": "huginn",
  "version": "0.1.0",
  "description": "CLI/TUI orchestrator for the opencode spec → execute → validate → test → secure → review → doc → commit cycle",
  "type": "module",
  "bin": {
    "huginn": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "bun run scripts/postinstall.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.14",
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
