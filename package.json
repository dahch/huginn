{
  "name": "@dahch/huginn",
  "version": "3.0.0-rc.3",
  "description": "CLI/TUI orchestrator for the agent-driven spec \u2192 execute \u2192 validate \u2192 test \u2192 secure \u2192 review \u2192 doc \u2192 commit cycle",
  "type": "module",
  "bin": {
    "huginn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist --minify --external @earendil-works/pi-coding-agent --external @openai/codex-sdk --external @anthropic-ai/claude-agent-sdk --external @qwen-code/sdk --external @moonshot-ai/kimi-agent-sdk --external better-sqlite3 --external @dahch/muninn --external typescript",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "media": "bun docs/media/capture.ts && python3 docs/media/render_media.py",
    "test": "bun test src && vitest run && bun run typecheck:test",
    "prepublishOnly": "bun run build && npm run test && bun run typecheck && bun run typecheck:test"
  },
  "dependencies": {
    "@dahch/muninn": "^0.1.0",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@moonshot-ai/kimi-agent-sdk": "0.1.8",
    "@openai/codex-sdk": "0.169.0",
    "@opencode-ai/sdk": "^1.19.5",
    "@qwen-code/sdk": "0.1.33",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dahch/huginn"
  },
  "keywords": [
    "opencode",
    "cli",
    "orchestrator",
    "spec",
    "build-cycle"
  ],
  "homepage": "https://github.com/dahch/huginn#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
