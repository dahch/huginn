{
  "servers": [
    {
      "name": "rea",
      "scope": "global",
      "source": "/home/dev/.pi/agent/mcp.json",
      "enabled": true,
      "exposure": "codemode",
      "transport": "npx -y rea-agents@6.7.0 mcp",
      "state": "connected",
      "tools": [
        "annotate_native_function",
        "inspect_macho",
        "trace_feature"
      ]
    },
    {
      "name": "muninn",
      "scope": "project",
      "source": "/home/dev/projects/lumion/.pi/mcp.json",
      "enabled": true,
      "exposure": "direct",
      "transport": "huginn mcp run --project /home/dev/projects/lumion",
      "state": "connected",
      "tools": [
        "muninn_context",
        "muninn_inspect_symbol",
        "muninn_verify_contract",
        "muninn_save",
        "muninn_search",
        "muninn_link_symbol",
        "muninn_stats"
      ]
    }
  ]
}
